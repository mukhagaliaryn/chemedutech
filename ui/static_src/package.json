{
  "name": "chemedutech-ui",
  "version": "4.6.0",
  "description": "ChemEduTech design tokens and Tailwind build (django-tailwind theme app)",
  "scripts": {
    "start": "npm run dev",
    "build": "npm run build:clean && npm run build:tailwind",
    "build:clean": "rimraf ../static/css/dist",
    "build:tailwind": "cross-env NODE_ENV=production postcss ./src/styles.css -o ../static/css/dist/styles.css --minify",
    "dev": "cross-env NODE_ENV=development postcss ./src/styles.css -o ../static/css/dist/styles.css --watch",
    "vendor": "cp node_modules/alpinejs/dist/cdn.min.js ../static/vendor/alpine.min.js && cp node_modules/htmx.org/dist/htmx.min.js ../static/vendor/htmx.min.js"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.30",
    "postcss-cli": "^12.0.0",
    "postcss-nested": "^8.0.1",
    "postcss-simple-vars": "^7.0.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "alpinejs": "^3.14.0",
    "htmx.org": "^2.0.0"
  },
  "private": true
}

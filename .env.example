DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The public address (certificate QR codes link to it)
SITE_URL=http://localhost:8000
# DJANGO_CSRF_TRUSTED_ORIGINS=https://chem.example.kz

POSTGRES_DB=chemedutech
POSTGRES_USER=chem
POSTGRES_PASSWORD=chem
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# USE_SQLITE=1   # quick local run without PostgreSQL

# Settings module: config.settings.dev (manage.py default) | config.settings.prod (wsgi/asgi default).
# manage.py reads it from this file, so on the server set it here.
# DJANGO_SETTINGS_MODULE=config.settings.prod
# Production only (DEPLOY.md): plain-HTTP first check by IP, HSTS once HTTPS is stable, app log level
# DJANGO_SECURE_SSL_REDIRECT=0
# DJANGO_SECURE_COOKIES=0
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_LOG_LEVEL=INFO

# AI grading of open practice answers (ARCHITECTURE §5.6)
ANTHROPIC_API_KEY=
AI_GRADING_MODEL=claude-sonnet-5-5
AI_GRADING_ENABLED=0
# AI_GRADING_TIMEOUT_S=30

# Outgoing email (password reset). Dev uses the console backend.
# DJANGO_EMAIL_HOST=smtp.example.kz
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=1
# DJANGO_DEFAULT_FROM_EMAIL=ChemEduTech <noreply@chem.example.kz>
# AI_GRADING_EFFORT=medium
# AI_GRADING_FALLBACKS=1
# ICPAI AI assistant (apps/ai): on/off, model, effort, timeout, requests per student per day, refusal fallback
AI_TUTOR_ENABLED=0
# AI_TUTOR_MODEL=claude-opus-5-5
# AI_TUTOR_EFFORT=low
# AI_TUTOR_TIMEOUT_S=60
# AI_TUTOR_DAILY_REQUESTS=60
# AI_TUTOR_FALLBACKS=1

msgstr "Талдау жіберілді"

#: apps/labs/models/attempt.py:24
msgid ""
"Empty for a teacher's preview and for attempts made before the course "
"structure"
msgstr ""
"Мұғалімнің алдын ала қарауында және курс құрылымына дейінгі талпыныстарда бос"

#: apps/labs/models/attempt.py:35
msgid "experiment"
msgstr "тәжірибе"

#: apps/labs/models/attempt.py:37
msgid "Snapshot at start (from the enrolment)"
msgstr "Басталған сәттегі мәні (курсқа жазылудан)"

#: apps/labs/models/attempt.py:45
msgid "order errors"
msgstr "рет қателері"

#: apps/labs/models/attempt.py:46
msgid "safety warnings"
msgstr "қауіпсіздік ескертулері"

#: apps/labs/models/attempt.py:47
msgid "wrong equipment or reagent"
msgstr "қате құрал немесе реагент"

#: apps/labs/models/attempt.py:48
